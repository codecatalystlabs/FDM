{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:go-sidecar",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "CatalystFDM",
    "version": "0.3.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.fdm.enorkity",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": "all",
      "externalBin": ["binaries/fdm-enorkity-server"]
    },
    "allowlist": {
      "all": false,
      "shell": {
        "open": true,
        "sidecar": true,
        "scope": [{ "name": "binaries/fdm-enorkity-server", "sidecar": true }]
      }
    },
    "windows": [
      {
        "title": "CatalystFDM",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
