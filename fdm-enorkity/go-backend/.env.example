APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=./storage/fdm.db
STORAGE_ROOT=./storage
LOG_DIR=./logs
DEFAULT_DOWNLOAD_DIR=./storage/downloads
MAX_CONCURRENT_DOWNLOADS=8
# Also used as the in-memory read buffer size per active download (clamped 64 KiB–2 MiB).
CHUNK_SIZE_BYTES=4194304
ALLOWED_EXTENSION_ORIGINS=
LOG_LEVEL=info
